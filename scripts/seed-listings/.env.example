# Copy to .env (gitignored) before running `npm run fetch`.
# `npm run seed` doesn't need JSEARCH_API_KEY — it reads from .cache/,
# already-fetched — only FIREBASE_SERVICE_ACCOUNT_PATH.

# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch — free tier is a
# hard 200 requests/month, so `npm run fetch` is meant to be run
# deliberately, not routinely. See README.md.
JSEARCH_API_KEY=your-rapidapi-key

# Path to the Firebase Admin SDK service account JSON (Project Settings ->
# Service Accounts -> Generate new private key). Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
