rules_version = '2';

// DEAD END, not deferred: Firebase Storage requires the Blaze plan (a
// billing card on file, even at $0 actual usage), which wasn't available.
// Resumes ended up as a base64 field directly on the Firestore profile
// doc instead — see "Decision: resume storage, twice reconsidered" in
// docs/ARCHITECTURE.md for the full path (Storage, then Cloudflare R2 —
// which turned out to need a card too — then this). Storage was never
// actually enabled on the project; these rules were written but never
// deployed, and stay here only as a record of that attempt.

service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{uid}/{fileName} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid
                          && request.resource.size < 10 * 1024 * 1024 // 10MB cap
                          && request.resource.contentType.matches('application/pdf');
    }
  }
}
