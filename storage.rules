rules_version = '2';

// Resume/CV uploads, used for the onboarding profile build and as context
// for the match-gap LLM call. Each user can only touch their own file.

service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{uid}/{fileName} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid
                          && request.resource.size < 10 * 1024 * 1024 // 10MB cap
                          && request.resource.contentType.matches('application/pdf');
    }
  }
}
