{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trusthire-ai-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Non-secret config. Secrets (GEMINI_API_KEY, FIREBASE_CLIENT_EMAIL,
  // FIREBASE_PRIVATE_KEY) are set via `wrangler secret put` — see README.md
  // — never here, so they never land in git.
  "vars": {
    "FIREBASE_PROJECT_ID": "trusthire-bdapps",
    // Matches firebase_options.dart's storageBucket. Read-only fetches for
    // resume-tailoring (storageClient.ts) go straight to this bucket via
    // the GCS JSON API, not through the Firebase Storage SDK.
    "FIREBASE_STORAGE_BUCKET": "trusthire-bdapps.firebasestorage.app",
    // gemini-2.5-flash is listed by ListModels but rejects generateContent
    // for this project with "no longer available to new users" (confirmed
    // live, 2026-08-25) — Google's own error names gemini-3.6-flash as the
    // replacement, confirmed present and non-preview in ListModels.
    "GEMINI_MODEL": "gemini-3.6-flash",
    "MATCH_MODEL_VERSION": "gemini-3.6-flash@match-v1",
    "SCAM_MODEL_VERSION": "gemini-3.6-flash@scam-v1",
    "RATE_LIMIT_PER_USER_PER_DAY": "50"
  },

  // Per-user daily call counters. A KV read on every request is cheap and
  // eventually-consistent writes are fine for a soft rate limit — a Durable
  // Object would give strict consistency we don't need here.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV", "id": "1ac4f9c2f3e54c51bcde334ee8d59712" }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
