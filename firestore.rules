rules_version = '2';

// Baseline security rules, matching the schema in docs/DATA_MODELS.md.
//
// Principle: the Flutter client is read-mostly. Anything derived from an
// LLM call (match results, scam assessments) or anything billing-related
// (subscriptions) is written server-side only — by the Cloudflare Worker /
// bdapps webhook handler using Admin credentials, which bypass these rules
// entirely. That keeps a compromised or modified client from forging a
// match score, a "verified" trust badge, or a paid subscription state.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Users: profile, skills, resume reference ---
    // Each user can read/write only their own document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // --- Resumes: multiple named versions per user (e.g. "AI/LLM
      // Resume", "General Resume") — each with its own Storage file.
      // Owner-only, same as the parent doc.
      match /resumes/{resumeId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Applications: user's own tracked status per listing (interested/
    // applied/interviewing/offer/rejected) — self-reported, not verified by
    // anything, so client-owned is fine (unlike matchResults/scamAssessments,
    // there's no "forging a verdict" risk here). `create` is checked
    // separately from `update`/`delete` (which check the *existing* doc's
    // owner instead) because `request.resource` — not `resource` — is what's
    // populated on create.
    //
    // `read` allows `resource == null` deliberately: a `get()`/`snapshots()`
    // listen on a path with no document yet still runs the `read` rule
    // (that's how a client is told "not found" rather than being denied
    // outright), and at that point `resource` itself is null — evaluating
    // `resource.data.userId` on a null `resource` is a rules *error*, which
    // Firestore treats as a hard deny, not a graceful "no data". Real bug
    // this caused, not a hypothetical: `ApplicationRepository.setStatus`
    // does a `.get()` first (to preserve `createdAt` on updates), which hit
    // exactly this on any listing never tracked before — everyone's very
    // first "Track" attempt silently failed with PERMISSION_DENIED.
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // --- Saved jobs: user's own bookmarks --- Same `resource == null` fix
    // as `applications`, for the same reason (the save-toggle's existence
    // check hits an as-yet-nonexistent document just as often).
    match /savedJobs/{savedJobId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // --- Job listings: curated feed, seeded/managed server-side ---
    // Readable by any signed-in user; never writable from the client.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Match results: per (user, listing) explainable match output ---
    // Cached by the Worker after a Gemini call. Client reads its own only.
    // `resource == null` guard: same reasoning as `applications`/`savedJobs`
    // above — `MatchRepository`'s cache-check reads this doc before the
    // Worker has ever computed it for a given listing, and a null `resource`
    // makes `resource.data.userId` a rules error, not a clean "not found".
    // Masked here (unlike applications/savedJobs) by a defensive try/catch
    // in `match_repository.dart` that treats any read failure as a cache
    // miss — harmless in effect, but worth fixing at the source rather than
    // relying on that catch to paper over a genuine rules bug.
    match /matchResults/{matchId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // --- Scam assessments: per-listing trust badge + reasoning ---
    // Not user-scoped (same listing = same assessment for everyone), but
    // still server-written only so a client can't fake a "Verified" badge.
    match /scamAssessments/{listingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Subscriptions: bdapps DCB paid-tier state ---
    // Written only by the server-side bdapps webhook handler.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
